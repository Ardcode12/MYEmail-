PORT=8787
HOST=127.0.0.1
PUBLIC_URL=http://localhost:8787
# Generate each secret with: openssl rand -hex 32
APP_TOKEN=
ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
DAILY_ANALYSIS_LIMIT=100
SYNC_INTERVAL_SECONDS=120

# Use in:inbox to backfill the whole inbox, or -in:sent -in:drafts for received mail.
GMAIL_QUERY="in:inbox newer_than:30d"

# Atlas connection string: keep this secret. Never put it in the mobile app.
MONGODB_URI=mongodb+srv://DB_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=briefmail
# Manual sync suits Render Free; set true only if you want polling while awake.
BACKGROUND_SYNC=false
